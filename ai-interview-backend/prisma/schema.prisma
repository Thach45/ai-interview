generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ================= ENUMS =================

enum Role {
  CANDIDATE
  MODERATOR
  ADMIN
}

enum SessionStatus {
  PENDING
  IN_PROGRESS
  EVALUATING
  COMPLETED
  FAILED
}

enum MessageRole {
  AI
  USER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ExperienceLevel {
  INTERN
  FRESHER
  JUNIOR
  MIDDLE
  SENIOR
  MANAGER
  DIRECTOR
}

enum Provider {
  GOOGLE
  LOCAL
}

enum CategoryType {
  GROUP
  INDUSTRY
  POSITION
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum InterviewMode {
  VIDEO
  TEXT
}

enum InterviewLanguage {
  VIETNAMESE
  ENGLISH
  BILINGUAL
}

enum InterviewPersona {
  PROFESSIONAL
  FRIENDLY
  STRICT
  CHEERFUL
}

enum CvSourceType {
  UPLOADED
  BUILDER
}

enum TransactionType {
  DEPOSIT
  COMPENSATION
  PROMOTION
}

enum AnalysisPriority {
  HIGH
  MEDIUM
  LOW
}

enum ScoreCategory {
  TECHNICAL_SKILLS
  EXPERIENCE
  SOFT_SKILLS
  EDUCATION
  PROJECT_RELEVANCE
}

enum NotificationType {
  AI_PROCESS
  BILLING
  REMINDER
  SYSTEM_UPDATE
  EMAIL
}

// ================= COMPOSITE TYPES =================

type MetricScore {
  score  Int
  reason String
}

type GeneralEvaluation {
  overall        MetricScore
  domain         MetricScore
  problemSolving MetricScore
  clarity        MetricScore
  confidence     MetricScore
  relevance      MetricScore
}

type RubricCriterion {
  id          String
  description String
  points      Int
}

type CriterionMatch {
  criterionId   String
  partialCredit Float
  evidence      String
}

type CoreQuestion {
  title    String
  reason   String
  criteria RubricCriterion[]
}

type AiModification {
  id     Int
  type   String
  title  String
  desc   String
}

type CvContact {
  phone    String?
  email    String?
  birthday String?
  address  String?
}

type CvExperience {
  company String?
  period  String?
  role    String?
  details String[]
}

type CvProject {
  name    String?
  period  String?
  role    String?
  details String[]
}

type CvSkill {
  name  String?
  level String?
}

type CvEducation {
  period   String?
  school   String?
  degree   String?
  details  String[]
}

type CvCertification {
  name    String?
  issuer  String?
  year    String?
}

type CvActivity {
  name    String?
  period  String?
  role    String?
  details String[]
}

type CvReference {
  name    String?
  role    String?
  phone   String?
}

type CvDataStructure {
  fullName        String
  jobTitle        String
  objective       String?
  contact         CvContact
  experiences     CvExperience[]
  projects        CvProject[]
  hardSkills      String[]
  computerSkills  CvSkill[]
  languages       CvSkill[]
  education       CvEducation[]
  certifications  CvCertification[]
  activities      CvActivity[]
  references      CvReference[]
}

type SkillAnalysis {
  skill    String
  user     Int
  required Int
}

type ImprovementSuggestion {
  title    String
  desc     String
  solution String
  priority AnalysisPriority
}

type ScoreDetail {
  category ScoreCategory
  score    Int
  reason   String
}

// ================= MODELS =================

model User {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  email            String           @unique
  fullName         String
  avatarUrl        String?
  role             Role             @default(CANDIDATE)
  password         String?
  provider         Provider         @default(LOCAL)
  googleId         String?
  status           UserStatus       @default(ACTIVE)
  emailVerifiedAt   DateTime?
  creditsBalance   Int              @default(3)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  cvs              UserCv[]
  sessions         InterviewSession[]
  cvAnalyses       CvAnalysis[]
  recruiterRooms   RecruiterRoom[]
  transactions     Transaction[]
  notifications    Notification[]
}

model UserCv {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  userId           String          @db.ObjectId
  title            String
  sourceType       CvSourceType    @default(UPLOADED)
  cvData           CvDataStructure?
  templateId       String?         @db.ObjectId
  renderedHtml     String?
  fileUrl          String?
  cvAnalysisId     String?         @db.ObjectId
  aiModifications  AiModification[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template         CvTemplate?     @relation(fields: [templateId], references: [id])
  cvAnalysis       CvAnalysis?     @relation("OptimizedCvToCvAnalysis", fields: [cvAnalysisId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessions         InterviewSession[]
  analyses         CvAnalysis[]    @relation("CvAnalysisToUserCv")
}

model JobCategory {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  type        CategoryType
  parentId    String?        @db.ObjectId
  parent      JobCategory?   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    JobCategory[]  @relation("CategoryHierarchy")
  jobTemplates JobTemplate[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model JobTemplate {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  companyName        String
  companyLogo        String?
  location           String?
  salaryRange        String?
  employmentType     String?
  experienceLevel    ExperienceLevel @default(JUNIOR)
  isRemote           Boolean         @default(false)
  categoryId         String?         @db.ObjectId
  category           JobCategory?    @relation(fields: [categoryId], references: [id])
  responsibilities   String
  requirements       String
  benefits           String
  aiExtractedContext String
  isHotJob           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  sessions           InterviewSession[]
  cvAnalyses         CvAnalysis[]
}

model InterviewSession {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  userId           String        @db.ObjectId
  status           SessionStatus @default(PENDING)
  mode             InterviewMode   @default(VIDEO)
  level            ExperienceLevel @default(JUNIOR)
  persona          InterviewPersona @default(PROFESSIONAL)
  language         InterviewLanguage @default(VIETNAMESE)
  difficulty       Int             @default(3)
  duration         Int             @default(30)
  focusSkills      String[]
  companyName      String?
  jobTitle         String
  coreQuestions    CoreQuestion[]
  jobTemplateId    String?       @db.ObjectId
  customJdText     String?
  cvId             String?       @db.ObjectId
  recruiterRoomId  String?       @db.ObjectId
  startedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cv               UserCv?        @relation(fields: [cvId], references: [id])
  jobTemplate      JobTemplate?   @relation(fields: [jobTemplateId], references: [id])
  recruiterRoom    RecruiterRoom? @relation(fields: [recruiterRoomId], references: [id])
  messages         InterviewMessage[]
  result           InterviewResult?
}

model InterviewMessage {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  sessionId        String      @db.ObjectId
  role             MessageRole
  content          String
  audioUrl         String?
  questionIndex    Int?
  isFollowUp       Boolean     @default(false)
  createdAt        DateTime    @default(now())
  session          InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId])
}

model InterviewResult {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId        String   @unique @db.ObjectId
  overallScore     Int
  generalEvaluation GeneralEvaluation
  recommendation   String
  summary          String
  strengths        String[]
  weaknesses       String[]
  learningPath     String[]
  createdAt        DateTime @default(now())
  session          InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionEvaluations QuestionEvaluation[]
}

model QuestionEvaluation {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  interviewResultId String   @db.ObjectId
  questionIndex     Int
  questionTitle     String
  feedback          String
  score             Float
  criteriaMatches   CriterionMatch[]
  interviewResult   InterviewResult @relation(fields: [interviewResultId], references: [id], onDelete: Cascade)
}

model SubscriptionPackage {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  tagline       String?
  price         Int
  oldPrice      Int?
  durationDays  Int
  credits       Int
  isPopular     Boolean  @default(false)
  features      String[]
  icon          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  transactions  Transaction[]
}

model Transaction {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  userId        String          @db.ObjectId
  type          TransactionType @default(DEPOSIT)
  packageId     String?         @db.ObjectId
  package       SubscriptionPackage? @relation(fields: [packageId], references: [id])
  amount        Int
  creditsAdded  Int
  status        PaymentStatus @default(PENDING)
  paymentRefId  String?
  sepayTransactionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CvAnalysis {
  id                     String                  @id @default(auto()) @map("_id") @db.ObjectId
  userId                 String                  @db.ObjectId
  cvId                   String                  @db.ObjectId
  jobTemplateId          String?                 @db.ObjectId
  externalJobDescription String?
  matchScore             Int
  summary                String?
  scoringDetails         ScoreDetail[]
  strengths              String[]
  weaknesses             String[]
  skillsAnalysis         SkillAnalysis[]
  foundKeywords          String[]
  missingKeywords        String[]
  improvementSuggestions ImprovementSuggestion[]
  createdAt              DateTime @default(now())
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cv                     UserCv      @relation("CvAnalysisToUserCv", fields: [cvId], references: [id], onDelete: Cascade)
  jobTemplate            JobTemplate? @relation(fields: [jobTemplateId], references: [id], onDelete: Cascade)
  optimizedCvs           UserCv[]      @relation("OptimizedCvToCvAnalysis")
}

model RecruiterRoom {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  hrId             String   @db.ObjectId
  roomName         String
  jdContext        String
  invitationToken  String   @unique @default(uuid())
  isActive         Boolean  @default(true)
  expiresAt        DateTime?
  createdAt        DateTime @default(now())
  hr               User               @relation(fields: [hrId], references: [id], onDelete: Cascade)
  sessions         InterviewSession[]
}

model VerificationCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([email])
}

model CvTemplate {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  thumbnailUrl  String
  htmlStructure String
  cssStyles     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userCvs       UserCv[]
}

model Notification {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  userId      String           @db.ObjectId
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  message     String
  link        String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  @@index([userId, createdAt(sort: Desc)])
}
